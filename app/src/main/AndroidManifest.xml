<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the Phone calendar connector, asked for only when the user switches it on -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- the language model download: a background service with a progress notification, kept awake while it runs -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Optional. Termux must be installed and the user must grant this in Termux's own settings. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Dvine"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation"
            android:exported="true"
            android:resizeableActivity="true"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.Dvine">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".chat.ui.CodeViewActivity"
            android:exported="false"
            android:theme="@style/Theme.Dvine" />
        <activity
            android:name=".chat.ui.HtmlViewActivity"
            android:exported="false"
            android:theme="@style/Theme.Dvine" />
        <activity
            android:name=".chat.ui.ImageViewActivity"
            android:exported="false"
            android:theme="@style/Theme.Dvine" />
        <activity
            android:name=".chat.ui.MediaPlayActivity"
            android:exported="false"
            android:theme="@style/Theme.Dvine" />
        <activity
            android:name=".chat.ui.HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Dvine" />
        <activity
            android:name=".chat.ui.ProvidersActivity"
            android:exported="false"
            android:theme="@style/Theme.Dvine.Sheet"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".chat.ui.SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.Dvine" />
        <activity
            android:name=".chat.ui.ConnectorsActivity"
            android:exported="false"
            android:theme="@style/Theme.Dvine"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".chat.ui.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Dvine" />
        <activity
            android:name=".chat.ui.UsageActivity"
            android:exported="false"
            android:theme="@style/Theme.Dvine" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="ai.dvine.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".llm.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".llm.ReplyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
