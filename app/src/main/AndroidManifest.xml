<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.ibiko">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the Phone calendar connector, asked for only when the user switches it on -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- the language model download: a background service with a progress notification, kept awake while it runs -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Ibiko keeps running in the background until the pilot closes it (main/KeepAlive) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- the networks a post is handed to, scheduled or now -->
        <package android:name="com.twitter.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.instagram.android" />
        <package android:name="com.linkedin.android" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.whatsapp" />
        <package android:name="com.reddit.frontpage" />
    </queries>

    <application
        android:name=".IbikoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Ibiko"
        android:usesCleartextTraffic="false"
        android:extractNativeLibs="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation"
            android:exported="true"
            android:resizeableActivity="true"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.Ibiko">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".chat.ui.AppFilesActivity"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!-- Share › Ibiko from any app: the file, picture or text lands in the composer, ready to send -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".chat.ui.CodeViewActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.HtmlViewActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.ImageViewActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.MediaPlayActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.ProvidersActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko.Sheet"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".chat.ui.SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.ConnectorsActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".chat.ui.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.SettingsProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.SettingsChatActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.SettingsLearningActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.SettingsWorkActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.SettingsModelsActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.SettingsWebActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.SettingsActionsActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.SettingsCodingActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.SettingsAppearanceActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.SettingsDataActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.SettingsAdvancedActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.SettingsAboutActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.UsageActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.MemoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.WorkspaceActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.SocialActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko" />
        <activity
            android:name=".chat.ui.TerminalActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".chat.ui.SocialLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Ibiko"
            android:windowSoftInputMode="adjustResize" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="ai.ibiko.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".main.KeepAlive"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="An AI assistant the user keeps running: replies, coding jobs and the Linux shell carry on in the background until the user closes it from the notification." />
        </service>
        <service
            android:name=".llm.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Ibiko 1's learning job -->
        <service
            android:name="ai.ibiko.ibiko1.LearningJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".llm.ReplyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".social.PostAlarm"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
