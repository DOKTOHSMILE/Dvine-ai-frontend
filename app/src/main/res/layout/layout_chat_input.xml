<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_main"
    android:baselineAligned="false"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- a short notice ("Claude didn't answer, so OpenAI did."), shown for a few seconds -->
    <TextView
        android:id="@+id/composer_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- quick actions over the message box: Tools, Code, Media, Explore, More (each opens its own sheet) -->
    <HorizontalScrollView
        android:id="@+id/quick_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quick_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_tools"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="Tools"
                android:drawableStart="@drawable/ic_tools_chip"
                android:drawableEnd="@drawable/ic_chevron_down"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:text="Tools"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_code"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="Code"
                android:drawableStart="@drawable/ic_code"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:text="Code"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_media"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="Media"
                android:drawableStart="@drawable/ic_media"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:text="Media"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_explore"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="Explore"
                android:drawableStart="@drawable/ic_globe"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:text="Explore"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_more"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="More"
                android:drawableStart="@drawable/ic_more_grid"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:text="More"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- the box: the words on top, the buttons in a row under them -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_container"
        android:baselineAligned="false"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <!-- A FrameLayout holds the scroller to the screen width. Without it the chip row
             makes this box as wide as the chips, and the text field folds into a sliver. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <HorizontalScrollView
                android:id="@+id/attach_scroll"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/attach_row"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </FrameLayout>

        <EditText
            android:id="@+id/et_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|start"
            android:hint="Ask Ibiko anything"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="6"
            android:minHeight="48dp"
            android:minLines="1"
            android:overScrollMode="ifContentScrolls"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:scrollbars="vertical"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/chat_hint"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_attach"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add a photo or file"
                android:scaleType="center"
                android:src="@drawable/ic_attach" />

            <!-- who answers: Obi (chat, first and the default), Ivie (graphics) or Ibiko (tools); icons, with the chosen one's name -->
            <LinearLayout
                android:id="@+id/personaTabs"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_segment"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/tabObi"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="Obi"
                    android:drawableStart="@drawable/ic_persona_chat"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:minWidth="40dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Obi"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabIvie"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="Ivie"
                    android:drawableStart="@drawable/ic_persona_graphics"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:minWidth="40dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Ivie"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabIbiko"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="Ibiko"
                    android:drawableStart="@drawable/ic_persona_tools"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:minWidth="40dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Ibiko"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_voice"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Speak"
                android:scaleType="center"
                android:src="@drawable/ic_mic" />

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_send_button"
                android:contentDescription="Send"
                android:scaleType="center"
                android:src="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
