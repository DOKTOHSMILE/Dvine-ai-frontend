<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:id="@+id/chatScreenRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main"
        android:orientation="vertical">

        <!-- header: menu · chat title over the model · Ibiko's Auto pill · new chat (48 dp targets, as in Claude) -->
        <LinearLayout
            android:id="@+id/chatHeader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Chats"
                android:scaleType="center"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="240dp"
                    android:singleLine="true"
                    android:text="DVINE"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_header_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:drawableEnd="@drawable/ic_chevron_down"
                    android:drawablePadding="2dp"
                    android:ellipsize="end"
                    android:maxWidth="240dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="4dp"
                    android:singleLine="true"
                    android:text="DVINE model"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Ibiko only: whether commands run without asking (Claude Code's auto-accept); tap to switch -->
            <TextView
                android:id="@+id/ibikoMode"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_mode_pill"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Ask"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnNewChat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="New chat"
                android:scaleType="center"
                android:src="@drawable/ic_new_chat" />
        </LinearLayout>

        <include layout="@layout/layout_system_banner" />

        <!-- Ivie only: the 3D canvas for what she draws and builds (hidden until there is something to show) -->
        <FrameLayout
            android:id="@+id/ivieCanvas"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_container"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/chatPaneHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <include layout="@layout/layout_empty_state" />

            <LinearLayout
                android:id="@+id/thoughtStatusContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_typing_pill"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/thoughtSpinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/accent" />

                <TextView
                    android:id="@+id/thoughtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxWidth="260dp"
                    android:singleLine="true"
                    android:text="Thinking…"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <include layout="@layout/layout_chat_input" />
    </LinearLayout>

    <View
        android:id="@+id/drawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- the drawer: 304 dp over a scrim, as in Claude: search, new chat, recents, settings at the foot -->
    <LinearLayout
        android:id="@+id/historyDrawer"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/bg_sidebar"
        android:clickable="true"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:text="DVINE"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnManageChats"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_container"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:text="Search chats"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnDrawerNew"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_drawer_row"
            android:drawableStart="@drawable/ic_new_chat"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="New chat"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="10dp"
            android:paddingBottom="6dp"
            android:text="Recents"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/border_subtle" />

        <TextView
            android:id="@+id/btnProviders"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_drawer_row"
            android:drawableStart="@drawable/ic_key"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="AI providers"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnConnectors"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_drawer_row"
            android:drawableStart="@drawable/ic_plug"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Connectors"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnTheme"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_drawer_row"
            android:drawableStart="@drawable/ic_settings"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Settings"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnUsage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_drawer_row"
            android:drawableStart="@drawable/ic_usage"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="Usage"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
