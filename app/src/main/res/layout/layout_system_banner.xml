<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/banner_crash"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:background="@drawable/bg_input_container"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/bg_send_button"
        android:gravity="center"
        android:text="!"
        android:textColor="@color/text_on_user"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The app closed unexpectedly last time."
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="The chat was kept. Copy the crash report if you want it sent."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_copy_crash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Copy"
        android:textColor="@color/accent_cyan"
        android:textSize="13sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:background="@android:color/transparent" />

    <ImageButton
        android:id="@+id/btn_dismiss"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_close"
        android:contentDescription="Dismiss" />
</LinearLayout>
