<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat, not DeviceDefault. The chat field is an AppCompat EditText. DeviceDefault crashes it at startup. -->
    <style name="Theme.Ibiko" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_main</item>
        <!-- the splash screen: Ibiko's face, alive (it glances, then blinks) on the app's own colour -->
        <item name="android:windowSplashScreenBackground">@color/bg_main</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_face_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:colorBackground">@color/bg_main</item>
        <item name="android:textColorPrimary">@color/chat_text</item>
        <item name="android:textColorSecondary">@color/chat_hint</item>
        <item name="android:editTextColor">@color/chat_text</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:editTextStyle">@style/Widget.Ibiko.ChatInput</item>
        <!-- every dialog in the app has the same look (Theme.Ibiko.Dialog) -->
        <item name="alertDialogTheme">@style/Theme.Ibiko.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Ibiko.Dialog</item>
    </style>

    <!-- The standard dialog: the app's surface on a rounded card, its own text colours, bold accent buttons. -->
    <style name="Theme.Ibiko.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="android:windowTitleStyle">@style/Ibiko.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/Ibiko.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Ibiko.DialogButton.Quiet</item>
        <item name="buttonBarNeutralButtonStyle">@style/Ibiko.DialogButton.Quiet</item>
    </style>

    <style name="Ibiko.DialogTitle" parent="RtlOverlay.DialogWindowTitle.AppCompat">
        <item name="android:textAppearance">@style/Ibiko.DialogTitle.Text</item>
    </style>

    <style name="Ibiko.DialogTitle.Text" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Ibiko.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Ibiko.DialogButton.Quiet">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- A sheet over the chat (AI providers): the chat stays visible, dimmed, behind it. -->
    <style name="Theme.Ibiko.Sheet" parent="Theme.Ibiko">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="Widget.Ibiko.ChatInput" parent="@android:style/Widget.EditText">
        <item name="android:textColor">@color/chat_text</item>
        <item name="android:textColorHint">@color/chat_hint</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
