<?xml version="1.0" encoding="utf-8"?>
<!-- Every dialog's card: the app's surface, rounded 24dp, a fine outline, inset from the screen's edges. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="20dp" android:insetRight="20dp" android:insetTop="24dp" android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <corners android:radius="24dp" />
        <solid android:color="@color/bg_surface" />
        <stroke android:width="1dp" android:color="@color/line" />
    </shape>
</inset>
