<!-- a quick-action chip over the message box: a rounded outline, lit while pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/line" /><stroke android:width="1dp" android:color="@color/accent" /><corners android:radius="18dp" /></shape></item>
    <item><shape><solid android:color="#00000000" /><stroke android:width="1dp" android:color="@color/line" /><corners android:radius="18dp" /></shape></item>
</selector>
