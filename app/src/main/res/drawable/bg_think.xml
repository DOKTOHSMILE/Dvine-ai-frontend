<!-- the Think pill: an outline when off, the accent tint with an accent edge when on -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"><shape><solid android:color="@color/card_on" /><stroke android:width="1dp" android:color="@color/accent" /><corners android:radius="16dp" /></shape></item>
    <item><shape><solid android:color="#00000000" /><stroke android:width="1dp" android:color="@color/line" /><corners android:radius="16dp" /></shape></item>
</selector>
