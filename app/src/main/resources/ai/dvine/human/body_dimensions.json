{
  "schema": "ANRE_BODY_DIMENSIONS_V1",
  "units": "meters",
  "coordinate_system": {
    "x": "left/right; anatomical left is negative X when facing the character from the front",
    "y": "vertical; floor is Y=0",
    "z": "depth; face/front is negative Z",
    "origin": "ground projection at midpoint between feet",
    "front_direction": [
      0,
      0,
      -1
    ]
  },
  "design_intent": {
    "description": "Neutral, adult, human-proportioned digital-human baseline for a 3D rig and procedural mesh.",
    "nominal_height_m": 1.8,
    "important_note": "These are engineering-friendly art/rigging proportions, not universal clinical or anthropometric standards. Scale or customize by character profile.",
    "symmetry": "Start symmetrical; apply intentional asymmetry only through a separate character profile.",
    "mesh_strategy": "Use smooth continuous skin surface or connected skinned meshes. Ellipsoids/capsules are blockout primitives, not final anatomy."
  },
  "global_calculations": {
    "height_m": 1.8,
    "head_height_ratio": 0.135,
    "head_height_m": 0.243,
    "head_units": 7.407,
    "shoulder_width_ratio": 0.259,
    "shoulder_width_m": 0.466,
    "hip_width_ratio": 0.192,
    "hip_width_m": 0.346,
    "arm_span_ratio": 1.0,
    "arm_span_m": 1.8,
    "leg_length_ratio": 0.49,
    "leg_length_m": 0.882,
    "formulae": [
      "dimension_m = normalized_dimension * character_height_m",
      "world_position = (normalized_x * height, normalized_y * height, normalized_z * height)",
      "left_right_pair: x_left = -x_center; x_right = +x_center",
      "ellipsoid_volume = (4/3) * PI * rx * ry * rz (use only for approximate volume checks)",
      "capsule/blockout limb radius varies linearly from proximal radius to distal radius",
      "joint_limit_degrees are local-coordinate rig constraints and must be calibrated/tested for the chosen rig"
    ]
  },
